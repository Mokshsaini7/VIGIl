# VIGIL Environment Configuration

PROJECT_NAME=VIGIL
VERSION=1.0.0
ENV=development

# Server Configuration
HOST=0.0.0.0
PORT=8000
SECRET_KEY=vigil_super_secret_jwt_key_sih_2026_secure_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
DATABASE_URL=sqlite:///./vigil.db
# PostgreSQL / PostGIS (Production):
# DATABASE_URL=postgresql://vigil_user:vigil_password@localhost:5432/vigil_db

# Security & Audio Settings
CHUNK_DURATION_SECONDS=5
MAX_AUDIO_SIZE_MB=25
ALLOW_ORIGINS=["*"]
